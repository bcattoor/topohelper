<UserControl x:Class="Infrabel.AutodeskPlatform.TopoHelper.UserControls.SettingsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
             xmlns:converters="clr-namespace:Infrabel.AutodeskPlatform.TopoHelper.UserControls.Converters"
             mc:Ignorable="d"

             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"></converters:BoolToVisibilityConverter>
    </UserControl.Resources>
    <DockPanel Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_Commands" ItemsSource="{Binding MenuItems}" DisplayMemberPath="FriendlyName">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter Property="Command" Value="{Binding Path=AutoCADCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_Help" DisplayMemberPath="FriendlyName">
                    <MenuItem Header="_About..." Click="MenuItem_Click_Navigate_Url" ToolTip="Over deze applicatie." />
                    <MenuItem Header="_Raporteer een probleem..." Click="MenuItem_Click_Navigate_Url" ToolTip="https://github.com/bcattoor/topohelper/issues/new/choose" />
                    <MenuItem Header="_Open website..." Click="MenuItem_Click_Navigate_Url" ToolTip="https://bcattoor.github.io/topohelper/welcome.html" />
                    <MenuItem Header="_View this on github..." Click="MenuItem_Click_Navigate_Url" ToolTip="https://github.com/bcattoor/topohelper" />
                </MenuItem>
            </Menu>
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Background="LightGray" DockPanel.Dock="Bottom">
            <Button Padding="5" Margin="5,3" Command="{Binding Path=SaveCommand}">Save</Button>
            <Button Padding="5" Margin="5,3" Command="{Binding Path=ReloadSettingsCommand}" >Reload</Button>
            <Button Padding="5" Margin="5,3" Command="{Binding Path=CancelCommand}">Close</Button>
            <Button Padding="5" Margin="5,3" Command="{Binding CancelOperationCommand}" IsEnabled="{Binding IsLoading}">Cancel Operation</Button>
            <TextBlock Text="Loading..." VerticalAlignment="Center" Margin="5,3"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
        <TabControl>


            <TabItem Header="CogoPoints">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Refresh" Command="{Binding RefreshCogoPointsCommand}" Margin="5" Padding="5"/>
                    <DataGrid ItemsSource="{Binding CogoPoints}" 
                              IsReadOnly="False" 
                              AutoGenerateColumns="False" EnableRowVirtualization="True"
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False"
                              x:Name="CogoPointsDataGrid"
                              KeyDown="DataGrid_KeyDown">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                   Header="Selecteer" />
                            <DataGridTextColumn Binding="{Binding PointNumber}" Header="Punt Nummer" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Name}" Header="Naam" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Easting}" Header="X" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Northing}" Header="Y" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Elevation}" Header="Z" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding RawDescription}" Header="Beschrijving" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding LabelStyleName}" Header="Label Stijl" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding PointStyleName}" Header="Punt Stijl" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding LayerName}" Header="Laag" IsReadOnly="True" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Verwerk geselecteerde COGO punten" 
                                          Command="{Binding ProcessSelectedCogoPointsCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Blocks">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Refresh" Command="{Binding RefreshBlocksCommand}" Margin="5" Padding="5"/>
                    <DataGrid ItemsSource="{Binding Blocks}" 
                              IsReadOnly="False" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False" EnableRowVirtualization="True"
                              x:Name="BlocksDataGrid"
                              KeyDown="DataGrid_KeyDown">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                   Header="Selecteer" />
                            <DataGridTextColumn Binding="{Binding Name}" Header="Naam" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Handle}" Header="Handle" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Layer}" Header="Laag" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding PositionX}" Header="X" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding PositionY}" Header="Y" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding PositionZ}" Header="Z" IsReadOnly="True" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Verwerk geselecteerde blokken" 
                                          Command="{Binding ProcessSelectedBlocksCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </DockPanel>
            </TabItem>
